        <mxCell id="42" value="&lt;b&gt;Purple — dense core:&lt;/b&gt; used for every generated token; exported in int4 groups and staged as int8 in PSRAM.&lt;br/&gt;&lt;b&gt;Blue — sparse tables:&lt;/b&gt; one row lookup per token; stored in flash.&lt;br/&gt;&lt;b&gt;Yellow — stream:&lt;/b&gt; full output head scan per generated token. The V2 head is tied to the token embedding." style="html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="727" width="590" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;PLE purpose:&lt;/b&gt; each layer receives a token-specific conditioning vector; the gate makes it multiplicative conditioning rather than a simple per-token bias." style="html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
